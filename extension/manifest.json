{
  "manifest_version": 3,
  "name": "YT Floating Downloader",
  "version": "1.0",
  "description": "IDM-style floating video downloader for YouTube.",
  "permissions": ["activeTab"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "http://127.0.0.1:8000/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/watch*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}